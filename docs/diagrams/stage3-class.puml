package "staff" {
  class Cashier STAFF {
    +describeCommands(): String
    +collectNextPayment(restaurant: Restaurant, turn: int): Optional<ActionResult>
    +availableTasks(restaurant: Restaurant, turn: int): List<TaskOption>
    +summariseTasks(restaurant: Restaurant, turn: int): String
  }
  class Chef STAFF {
    +describeCommands(): String
    #handle(command: StaffCommand, restaurant: Restaurant, turn: int): ActionResult
    +cook(restaurant: Restaurant, orderId: int, turn: int): ActionResult
    +ordersToCook(restaurant: Restaurant): List<Order>
    +availableTasks(restaurant: Restaurant, turn: int): List<TaskOption>
  }
  class Host <<new>> NEWC {
    +describeCommands(): String
    #handle(command: StaffCommand, restaurant: Restaurant, turn: int): ActionResult
    +seat(restaurant: Restaurant, customerId: int): ActionResult
    +availableTasks(restaurant: Restaurant, turn: int): List<TaskOption>
  }
  abstract class Staff STAFF {
    -taskUsed: boolean
    {abstract} +availableTasks(restaurant: Restaurant, turn: int): List<TaskOption>
    +summariseTasks(restaurant: Restaurant, turn: int): String
    +startTurn(): void
    +hasActed(): boolean
    +carryOut(command: StaffCommand, restaurant: Restaurant, turn: int): ActionResult
    #handle(command: StaffCommand, restaurant: Restaurant, turn: int): ActionResult
    {abstract} +describeCommands(): String
    +waitTurn(): ActionResult
    #perform(task: Supplier<ActionResult>): ActionResult
  }
  class StaffCommand STAFF {
    -action: Action
    -targetId: int
    {static} +waitCommand(): StaffCommand
    +toCommandText(): String
    +toString(): String
  }
  enum "StaffCommand.Action" as Action STAFF {
    SEAT
    ORDER
    SERVE
    COOK
    WAIT
    ..
    +getKeyword(): String
  }
  class TaskOption STAFF {
    -command: StaffCommand
    -description: String
