  class GameController <<changed>> CHANGEDC {
    -config: GameConfig
    -restaurant: Restaurant
    -menu: Menu
    -happyHour: HappyHour
    -directedStaff: List<Staff>
    -cashier: Cashier
    -view: GameView
    -nextCustomerId: int
    +play(): GameResult
    -playTurn(turn: int): void
    -startOfTurnHappyHour(turn: int): void
    -runStaffChoice(staff: Staff, turn: int): void
