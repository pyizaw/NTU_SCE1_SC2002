    -echoInput: boolean
    -inputEnded: boolean
    -config: GameConfig
    -eventsInStep: int
    -currentStep: TurnStep
    -satisfactionAtStart: Map<Integer, Integer>
    -- implements every GameView operation --
  }
  interface GameView <<changed>> CHANGEDC {
    +showWelcome(config: GameConfig, menu: Menu): void
    +showTurnHeader(turn: int, maxTurns: int): void
    +showStep(step: TurnStep): void
    +showStatus(restaurant: Restaurant, turn: int, staff: List<Staff>): void
