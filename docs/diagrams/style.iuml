' Shared look for every diagram.
' Colours by layer:  boundary = blue, control = orange, staff = purple,
'                    domain/entity = green, menu & pricing = yellow, enums/util = grey
' In the stage diagrams, classes NEW in that stage are bright green and
' classes CHANGED in that stage are amber.
!pragma layout smetana
skinparam dpi 110
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundCorner 8
skinparam packageStyle rectangle
skinparam ArrowColor #555555
skinparam ArrowThickness 1.1
skinparam class {
  BorderColor #5A5A5A
  HeaderFontStyle bold
  StereotypeFontSize 10
}
skinparam package {
  BorderColor #9E9E9E
  FontColor #616161
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C9A227
  FontSize 11
}
skinparam legend {
  BackgroundColor #FAFAFA
  BorderColor #BDBDBD
  FontSize 11
}
skinparam title {
  FontSize 17
  FontStyle bold
}

!define BOUNDARY #E3F2FD
!define CONTROL  #FFF3E0
!define STAFF    #F3E5F5
!define DOMAIN   #E8F5E9
!define MENU     #FFFDE7
!define ENUMC    #ECEFF1
!define NEWC     #A5D6A7
!define CHANGEDC #FFCC80
